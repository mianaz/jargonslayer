{
  "name": "jargonslayer",
  "private": true,
  "description": "Private, fully local bilingual meeting engine for the Mac — dual mic+system capture, live 中英 transcript, vault export (私有、全本地的 Mac 双语会议引擎)",
  "license": "AGPL-3.0-only",
  "author": "Miana Zeng",
  "repository": {
    "type": "git",
    "url": "https://github.com/mianaz/jargonslayer.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "build:extension": "npm run build -w apps/extension",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dev:desktop": "npm run dev -w apps/desktop",
    "fetch:uv": "node scripts/fetch-uv.mjs",
    "build:audiocap": "node scripts/build-audiocap.mjs",
    "tauri:build": "npm run build -w apps/desktop",
    "build:ios": "BUILD_TARGET=ios node scripts/build-desktop.mjs",
    "dev:ios": "node scripts/check-ios-plist.mjs && PATH=\"$HOME/.cargo/bin:$PATH\" npm run tauri -w apps/desktop -- ios dev",
    "build:ios-app": "node scripts/check-ios-plist.mjs && PATH=\"$HOME/.cargo/bin:$PATH\" npm run tauri -w apps/desktop -- ios build",
    "check:versions": "node scripts/check-versions.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:sidecar": "node scripts/test-sidecar.mjs",
    "postinstall": "node scripts/copy-ffmpeg-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
